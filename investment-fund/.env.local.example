# Point this at your own backend's base URL (no trailing slash).
# Every call in lib/api.ts is prefixed with this, e.g. GET {NEXT_PUBLIC_API_URL}/fund/{id}
NEXT_PUBLIC_API_URL=http://localhost:8081/api

# Your fund's id — the fund endpoints are scoped by :id (GET /fund/:id, POST /fund/:id/add)
NEXT_PUBLIC_FUND_ID=1
